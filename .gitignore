# Scope this repository to gym source code and docs only.
/*
!/.gitignore
!/CLAUDE.md
!/gym/
/gym/**
!/gym/**/
!/gym/*.md
!/gym/**/*.md
!/gym/*.py
!/gym/**/*.py
!/gym_try.py
!/gym/bulgarian/bulgarian_angle_changes.csv
!/gym/bulgarian/bulgarian_angles.csv
